# Copy to .env (project root) and fill in. Never commit the real file.
BITSOPAY_ADMIN_TOKEN=change-me-to-a-long-random-token
BITSOPAY_BASE_URL=https://pay.example.com
# Set to 1 only when running behind a reverse proxy you control:
BITSOPAY_TRUST_PROXY=1
# Optional database-free links:
# BITSOPAY_SECRET=change-me-to-a-long-random-secret
# BITSOPAY_UPI_ID=shop@okhdfcbank
# BITSOPAY_PAYEE_NAME=My Shop
